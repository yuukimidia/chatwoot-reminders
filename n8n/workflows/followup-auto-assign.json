{
  "name": "Followup - Auto Assign Ad Leads",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      },
      "id": "schedule-trigger",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [\n  { json: { inbox_id: 6 } },\n  { json: { inbox_id: 5 } },\n  { json: { inbox_id: 7 } }\n];"
      },
      "id": "inboxes",
      "name": "Inboxes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.CHATWOOT_BASE_URL }}/api/v1/accounts/1/conversations",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "inbox_id", "value": "={{ $json.inbox_id }}" },
            { "name": "status", "value": "open" },
            { "name": "assignee_type", "value": "unassigned" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "api_access_token", "value": "={{ $env.CHATWOOT_API_TOKEN }}" }]
        },
        "options": {}
      },
      "id": "get-unassigned-conversations",
      "name": "Get Unassigned Conversations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = ($json.data && $json.data.payload) || [];\nreturn payload.map(conv => ({ json: conv }));"
      },
      "id": "split-conversations",
      "name": "Split Conversations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.CHATWOOT_BASE_URL }}/api/v1/accounts/1/conversations/{{ $json.id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "api_access_token", "value": "={{ $env.CHATWOOT_API_TOKEN }}" }]
        },
        "options": {}
      },
      "id": "get-messages",
      "name": "Get Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msgs = $json.payload || ($json.data && $json.data.payload) || [];\nconst sorted = [...msgs].sort((a, b) => a.created_at - b.created_at);\nconst first = sorted[0];\nconst text = (first && first.content ? first.content : '').toLowerCase();\nconst isAdLead = /\\[protocolo|vim dos an[uú]ncios/i.test(text);\nconst conv = $('Split Conversations').item.json;\nreturn { json: { conversation_id: conv.id, is_ad_lead: isAdLead } };"
      },
      "id": "check-ad-pattern",
      "name": "Check Ad Pattern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.is_ad_lead }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-ad-lead",
      "name": "Is Ad Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHATWOOT_BASE_URL }}/api/v1/accounts/1/conversations/{{ $json.conversation_id }}/assignments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "api_access_token", "value": "={{ $env.CHATWOOT_API_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ assignee_id: 1 }) }}",
        "options": {}
      },
      "id": "assign-conversation",
      "name": "Assign Conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0]
    }
  ],
  "connections": {
    "Every 15 min": { "main": [[{ "node": "Inboxes", "type": "main", "index": 0 }]] },
    "Inboxes": { "main": [[{ "node": "Get Unassigned Conversations", "type": "main", "index": 0 }]] },
    "Get Unassigned Conversations": { "main": [[{ "node": "Split Conversations", "type": "main", "index": 0 }]] },
    "Split Conversations": { "main": [[{ "node": "Get Messages", "type": "main", "index": 0 }]] },
    "Get Messages": { "main": [[{ "node": "Check Ad Pattern", "type": "main", "index": 0 }]] },
    "Check Ad Pattern": { "main": [[{ "node": "Is Ad Lead?", "type": "main", "index": 0 }]] },
    "Is Ad Lead?": { "main": [[{ "node": "Assign Conversation", "type": "main", "index": 0 }]] }
  }
}
